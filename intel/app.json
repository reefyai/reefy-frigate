{
  "slug": "frigate-intel",
  "version": "2026.09.11-00",
  "name": "Frigate NVR (Intel GPU)",
  "icon": "icon.png",
  "description": "Real-time AI object detection for IP cameras with Intel VAAPI and OpenVINO acceleration",
  "image": "ghcr.io/blakeblackshear/frigate:0.17.0",
  "default_port": 5000,
  "volumes": {
    "config": {
      "mount": "/config",
      "uid": 0,
      "backup": [
        "borgbase"
      ],
      "storage_class": "state"
    },
    "media": {
      "mount": "/media/frigate",
      "uid": 0,
      "backup": [
        "nas"
      ],
      "storage_class": "bulk"
    },
    "models": {
      "mount": "/models",
      "uid": 0,
      "backup": [],
      "storage_class": "bulk"
    },
    "cache": {
      "mount": "/tmp/cache",
      "uid": 0,
      "storage_class": "bulk",
      "backup": []
    }
  },
  "files": [
    {
      "url": "https://cdn.reefy.ai/models/frigate/yolo_nas_s.onnx",
      "path": "/models/yolo_nas_s.onnx"
    }
  ],
  "env": {
    "LIBVA_DRIVER_NAME": "iHD"
  },
  "devices": [
    "intel.com/gpu=all",
    "intel.com/npu=all"
  ],
  "shm_size": "512m",
  "gpu": false,
  "tags": [
    "pro"
  ]
}
